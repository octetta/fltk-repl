window "demo window" 800 400

slider note 0 127 "=10,%d" =69 ~live

slider duration   0 7  1 "DL ${track} %d - - - - -" =0 ~live
slider multply    0 15 1 "DL ${track} - %d - - - -" =0 ~live
slider feedback   0 15 1 "DL ${track} - - %d - - -" =0 ~live
slider modulation 0 31 1 "DL ${track} - - - %d - -" =0 ~live
slider depth      0 31 1 "DL ${track} - - - - %d -" =0 ~live
slider amount     0 15 1 "DL ${track} - - - - - %d" =0 ~live

grid 1 4
  button a4 "v0n69l1" "v0l0"
  button b4 "v0n70l1" "v0l0"
  button start "y0z1"
  button stop  "y0z0"
endgrid

grid 1 2
  button kick "v10 l1"
  button snare "v11 l1"
endgrid
